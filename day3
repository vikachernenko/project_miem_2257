package main

import (
	"fmt"
	"image"
	"image/color"
	"image/png"
	"math"
	"math/cmplx"
	"os"
	"os/exec"
	"runtime"
	"sync"
	"time"
)

func calculateFractal(name string, w, h, maxIter int, jc complex128) [][]int {
	iterations := make([][]int, h)
	for i := range iterations {
		iterations[i] = make([]int, w)
	}

	var xmin, xmax, ymin, ymax float64
	switch name {
	case "julia":
		xmin, xmax, ymin, ymax = -1.6, 1.6, -1.2, 1.2
	case "bship":
		xmin, xmax, ymin, ymax = -2.2, 1.2, -2.0, 1.0
	default:
		xmin, xmax, ymin, ymax = -2.0, 1.0, -1.2, 1.2
	}

	var wg sync.WaitGroup
	numWorkers := runtime.NumCPU()

	for i := 0; i < numWorkers; i++ {
		wg.Add(1)
		go func(workerID int) {
			defer wg.Done()
			for py := workerID; py < h; py += numWorkers {
				for px := 0; px < w; px++ {
					c := complex(
						xmin+(float64(px)/float64(w))*(xmax-xmin),
						ymin+(float64(py)/float64(h))*(ymax-ymin),
					)

					var n int
					switch name {
					case "mandelbrot":
						z := complex(0, 0)
						for i := 0; i < maxIter; i++ {
							if cmplx.Abs(z) > 2 {
								n = i
								break
							}
							z = z*z + c
							n = maxIter
						}
					case "julia":
						z := c
						for i := 0; i < maxIter; i++ {
							if cmplx.Abs(z) > 2 {
								n = i
								break
							}
							z = z*z + jc
							n = maxIter
						}
					case "bship":
						z := complex(0, 0)
						for i := 0; i < maxIter; i++ {
							zAbs := complex(math.Abs(real(z)), math.Abs(imag(z)))
							z = zAbs*zAbs + c
							if cmplx.Abs(z) > 2 {
								n = i
								break
							}
							n = maxIter
						}
					}
					iterations[py][px] = n
				}
			}
		}(i)
	}
	wg.Wait()
	return iterations
}

func renderAndSave(data [][]int, palette []color.Color, filename string) error {
	h := len(data)
	w := len(data[0])
	maxIter := len(palette) - 1
	img := image.NewRGBA(image.Rect(0, 0, w, h))

	for py := 0; py < h; py++ {
		for px := 0; px < w; px++ {
			iterations := data[py][px]
			if iterations >= maxIter {
				img.Set(px, py, color.Black)
			} else {
				img.Set(px, py, palette[iterations])
			}
		}
	}

	file, err := os.Create(filename)
	if err != nil {
		return err
	}
	defer file.Close()
	return png.Encode(file, img)
}

func openImage(path string) {
	var cmd *exec.Cmd
	switch runtime.GOOS {
	case "windows":
		cmd = exec.Command("rundll32", "url.dll,FileProtocolHandler", path)
	case "darwin":
		cmd = exec.Command("open", path)
	default:
		cmd = exec.Command("xdg-open", path)
	}
	_ = cmd.Start()
}

func main() {
	const w, h = 1024, 768
	const maxIter = 500
	const jc = complex(-0.7, 0.27015)

	palette := make([]color.Color, maxIter+1)
	for i := 0; i < maxIter; i++ {
		t := float64(i) / float64(maxIter)
		r := uint8(math.Mod(100*t+float64(i)*0.5, 256))
		g := uint8(100 * t)
		b := uint8(100*(1-t) + 200*t)
		palette[i] = color.RGBA{r, g, b, 255}
	}

	fractalNames := []string{"mandelbrot", "julia", "bship"}

	fmt.Println("Starting Fractal Generation...")
	fmt.Println("========================================")

	for _, name := range fractalNames {
		filename := name + ".png"
		fmt.Printf("Processing: %-12s [%dx%d]\n", name, w, h)

		startCalc := time.Now()
		iterationData := calculateFractal(name, w, h, maxIter, jc)
		durCalc := time.Since(startCalc)

		startSave := time.Now()
		err := renderAndSave(iterationData, palette, filename)
		durSave := time.Since(startSave)

		if err != nil {
			fmt.Printf("  Error saving %s: %v\n", filename, err)
			continue
		}

		totalTime := durCalc + durSave
		
		fmt.Printf("  ├─ Calculation: %v\n", durCalc)
		fmt.Printf("  ├─ Save/Render: %v\n", durSave)
		fmt.Printf("  └─ Total:       %v\n", totalTime)
		fmt.Println("----------------------------------------")

		openImage(filename)
	}

	fmt.Println("All tasks completed.")
}
