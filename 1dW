package main

import (
	"bufio"
	"fmt"
	"log"
	"math"
	"os"
	"strconv"
	"strings"
)

type DataPoint struct {
	Position int
	Count    int
}

func main() {
	dataPoints, err := readData("histogram_1d.csv")
	if err != nil {
		log.Fatal(err)
	}

	fmt.Println("АНАЛИЗ ДАННЫХ ГИСТОГРАММЫ")
	fmt.Println(strings.Repeat("=", 50))

	analyzeDataSimple(dataPoints)

	createTextVisualization(dataPoints, 60)

	createHTMLHistogram(dataPoints, "histogram_interactive.html")

	createExcelData(dataPoints, "histogram_data.csv")

	fmt.Println("\nВсе файлы успешно созданы!")
}

func readData(filename string) ([]DataPoint, error) {
	file, err := os.Open(filename)
	if err != nil {
		return nil, err
	}
	defer file.Close()

	var dataPoints []DataPoint
	scanner := bufio.NewScanner(file)

	if scanner.Scan() {
	}

	for scanner.Scan() {
		line := scanner.Text()
		parts := strings.Split(line, ",")
		if len(parts) < 2 {
			continue
		}

		position, _ := strconv.Atoi(strings.TrimSpace(parts[0]))
		count, _ := strconv.Atoi(strings.TrimSpace(parts[1]))

		dataPoints = append(dataPoints, DataPoint{
			Position: position,
			Count:    count,
		})
	}

	return dataPoints, scanner.Err()
}

type Statistics struct {
	Total       int
	Mean        float64
	StdDev      float64
	MinPos      int
	MaxPos      int
	MaxCount    int
	MaxPosVal   int
	Symmetry    float64
}

func analyzeDataSimple(dataPoints []DataPoint) Statistics {
	var stats Statistics

	total := 0
	sumPos := 0
	sumSq := 0
	maxCount := 0
	maxPos := 0
	minPos := dataPoints[0].Position
	maxPosVal := dataPoints[0].Position

	for _, dp := range dataPoints {
		total += dp.Count
		sumPos += dp.Position * dp.Count
		sumSq += dp.Position * dp.Position * dp.Count

		if dp.Count > maxCount {
			maxCount = dp.Count
			maxPos = dp.Position
		}
		if dp.Position < minPos {
			minPos = dp.Position
		}
		if dp.Position > maxPosVal {
			maxPosVal = dp.Position
		}
	}

	stats.Total = total
	stats.Mean = float64(sumPos) / float64(total)
	variance := float64(sumSq)/float64(total) - stats.Mean*stats.Mean
	if variance < 0 {
		variance = 0
	}
	stats.StdDev = math.Sqrt(variance)
	stats.MinPos = minPos
	stats.MaxPos = maxPos
	stats.MaxCount = maxCount
	stats.MaxPosVal = maxPosVal

	leftSum := 0
	rightSum := 0
	midIndex := len(dataPoints) / 2

	for i := 0; i < midIndex; i++ {
		leftSum += dataPoints[i].Count
		rightSum += dataPoints[len(dataPoints)-1-i].Count
	}

	if rightSum > 0 {
		stats.Symmetry = float64(leftSum) / float64(rightSum)
	}

	fmt.Printf("Всего случаев: %d\n", stats.Total)
	fmt.Printf("Диапазон позиций: %d до %d\n", stats.MinPos, stats.MaxPosVal)
	fmt.Printf("Средняя позиция: %.2f\n", stats.Mean)
	fmt.Printf("Стандартное отклонение: %.2f\n", stats.StdDev)
	fmt.Printf("Теоретическое σ (√200): %.2f\n", math.Sqrt(200))
	fmt.Printf("Отклонение от теории: %.1f%%\n",
		math.Abs(stats.StdDev-math.Sqrt(200))/math.Sqrt(200)*100)
	fmt.Printf("Позиция с максимумом: %d (количество: %d)\n", stats.MaxPos, stats.MaxCount)
	fmt.Printf("Коэффициент симметрии: %.4f\n", stats.Symmetry)

	if stats.StdDev > 0 {
		skewness := calculateSkewness(dataPoints, stats)
		fmt.Printf("Коэффициент асимметрии: %.4f\n", skewness)

		if math.Abs(skewness) < 0.5 {
			fmt.Println("✓ Распределение близко к симметричному")
		} else {
			fmt.Println("⚠ Распределение имеет заметную асимметрию")
		}
	}

	return stats
}

func calculateSkewness(dataPoints []DataPoint, stats Statistics) float64 {
	total := float64(stats.Total)
	sumCubed := 0.0

	for _, dp := range dataPoints {
		dev := float64(dp.Position) - stats.Mean
		sumCubed += float64(dp.Count) * dev * dev * dev
	}

	if stats.StdDev == 0 {
		return 0
	}

	return sumCubed / (total * math.Pow(stats.StdDev, 3))
}

func createTextVisualization(dataPoints []DataPoint, width int) {
	fmt.Println("\n" + strings.Repeat("═", 80))
	fmt.Println("ВИЗУАЛИЗАЦИЯ ГИСТОГРАММЫ")
	fmt.Println(strings.Repeat("═", 80))

	maxCount := 0
	for _, dp := range dataPoints {
		if dp.Count > maxCount {
			maxCount = dp.Count
		}
	}

	fmt.Println("\nГОРИЗОНТАЛЬНАЯ ГИСТОГРАММА С ДАННЫМИ:")
	for _, dp := range dataPoints {
		if dp.Count == 0 {
			continue
		}

		scaled := int(float64(dp.Count) / float64(maxCount) * float64(width))

		bar := strings.Repeat("█", scaled)
		if scaled == 0 && dp.Count > 0 {
			bar = "▌"
		}

		total := 0
		for _, d := range dataPoints {
			total += d.Count
		}
		percentage := float64(dp.Count) / float64(total) * 100

		fmt.Printf("Позиция %4d: %-*s %7d (%5.1f%%)\n",
			dp.Position, width, bar, dp.Count, percentage)
	}
}

