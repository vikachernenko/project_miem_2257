func createExcelData(dataPoints []DataPoint, filename string) {
	file, err := os.Create(filename)
	if err != nil {
		log.Fatal(err)
	}
	defer file.Close()

	writer := bufio.NewWriter(file)
	defer writer.Flush()

	writer.WriteString("Position,Count,Probability,Density,Cumulative,Normalized\n")

	total := 0
	for _, dp := range dataPoints {
		total += dp.Count
	}

	cumulative := 0
	mean, stdDev := calculateMeanStdDev(dataPoints)

	for _, dp := range dataPoints {
		cumulative += dp.Count
		probability := float64(dp.Count) / float64(total)
		cumulativeProb := float64(cumulative) / float64(total)

		density := 0.0
		if stdDev > 0 {
			z := (float64(dp.Position) - mean) / stdDev
			density = math.Exp(-z*z/2) / (stdDev * math.Sqrt(2*math.Pi))
		}

		normalized := (float64(dp.Position) - mean) / stdDev

		fmt.Fprintf(writer, "%d,%d,%.6f,%.6f,%.6f,%.6f\n",
			dp.Position, dp.Count, probability, density, cumulativeProb, normalized)
	}

	fmt.Printf("Данные для Excel сохранены в: %s\n", filename)
}

func calculateMeanStdDev(dataPoints []DataPoint) (mean, stdDev float64) {
	total := 0
	sumPos := 0
	sumSq := 0

	for _, dp := range dataPoints {
		total += dp.Count
		sumPos += dp.Position * dp.Count
		sumSq += dp.Position * dp.Position * dp.Count
	}

	if total == 0 {
		return 0, 0
	}

	mean = float64(sumPos) / float64(total)
	variance := float64(sumSq)/float64(total) - mean*mean
	if variance < 0 {
		variance = 0
	}
	stdDev = math.Sqrt(variance)

	return mean, stdDev
}
