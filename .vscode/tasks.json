{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Universal Super-Build (Ryzen 5600H)",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-O3",                   
                "-march=native",         
                "-fopenmp",              
                "-funroll-loops",        
                "-std=c++17",            
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-lopenblas"             
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Сборка для Фракталов, Матриц и Random Walk с AVX2 и OpenMP"
        }
    ]
}