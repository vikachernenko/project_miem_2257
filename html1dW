        <script>
            const bars = document.querySelectorAll('.bar');
            const tooltip = document.getElementById('tooltip');
            
            bars.forEach(bar => {
                bar.addEventListener('mouseover', (e) => {
                    const rect = bar.getBoundingClientRect();
                    
                    tooltip.style.display = 'block';
                    tooltip.style.left = (rect.left + window.scrollX) + 'px';
                    tooltip.style.top = (rect.top + window.scrollY - 80) + 'px';
                    
                    tooltip.innerHTML = 
                        '<strong>Позиция:</strong> ' + bar.dataset.position + '<br>' +
                        '<strong>Количество:</strong> ' + bar.dataset.count + '<br>' +
                        '<strong>Доля от общего:</strong> ' + bar.dataset.percent + '%';
                });
                
                bar.addEventListener('mouseout', () => {
                    tooltip.style.display = 'none';
                });
            });
            
            const histogram = document.getElementById('histogram');
            const svgNS = "http://www.w3.org/2000/svg";
            const normalCurve = document.createElementNS(svgNS, "svg");
            normalCurve.setAttribute("class", "normal-curve");
            normalCurve.setAttribute("width", "100%");
            normalCurve.setAttribute("height", "100%");
            
            const path = document.createElementNS(svgNS, "path");
            path.setAttribute("class", "normal-line");
            
            const mean = -0.00;
            const stdDev = 14.13;
            const maxCnt = 112734;
            const minPos = -68;
            const maxPos = 66;
            
            const points = [];
            
            for(let i = -3; i <= 3; i += 0.1) {
                const x = mean + i * stdDev;
                const y = Math.exp(-i*i/2) / (stdDev * Math.sqrt(2*Math.PI)) * maxCnt * 10;
                points.push([x, y]);
            }
            
            const xScale = 100 / (maxPos - minPos);
            const yScale = 500 / maxCnt;
            
            let d = "M ";
            points.forEach((point, i) => {
                const x = (point[0] - minPos) * xScale;
                const y = 500 - point[1] * yScale;
                d += x + "," + y + " ";
                if(i < points.length - 1) d += "L ";
            });
            
            path.setAttribute("d", d);
            normalCurve.appendChild(path);
            histogram.appendChild(normalCurve);
        </script>
        
